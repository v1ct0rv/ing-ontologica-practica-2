@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ins:  <http://www.unal.edu.co/ontologies/insolvencia#> .

###############################################################################
# Ontology declaration
###############################################################################
<http://www.unal.edu.co/ontologies/insolvencia>
    a owl:Ontology ;
    rdfs:label "Ontologia de Insolvencia Empresarial Colombia"@es ;
    rdfs:comment "Ontologia OWL que modela los conceptos del regimen de insolvencia empresarial colombiano, incluyendo Ley 1116 de 2006, Decreto 806 de 2020 y normas relacionadas."@es ;
    owl:versionInfo "1.0" .

###############################################################################
# Classes (16 clases, supera el minimo de 10)
###############################################################################
ins:EntidadJuridica   a owl:Class ;
    rdfs:label "Entidad Juridica"@es ;
    rdfs:comment "Clase base para personas y organizaciones involucradas en procesos de insolvencia."@es .

ins:Deudor            a owl:Class ;
    rdfs:subClassOf ins:EntidadJuridica ;
    rdfs:label "Deudor"@es ;
    rdfs:comment "Persona natural o juridica que se encuentra en estado de insolvencia o cesacion de pagos."@es .

ins:PersonaJuridica   a owl:Class ;
    rdfs:subClassOf ins:Deudor ;
    rdfs:label "Persona Juridica"@es ;
    rdfs:comment "Empresa o sociedad comercial con personeria juridica."@es .

ins:PersonaNatural    a owl:Class ;
    rdfs:subClassOf ins:Deudor ;
    rdfs:label "Persona Natural"@es ;
    rdfs:comment "Individuo natural que actua como comerciante."@es .

ins:Acreedor          a owl:Class ;
    rdfs:subClassOf ins:EntidadJuridica ;
    rdfs:label "Acreedor"@es ;
    rdfs:comment "Persona o entidad a quien se le debe una obligacion."@es .

ins:AcreedorPrivilegiado a owl:Class ;
    rdfs:subClassOf ins:Acreedor ;
    rdfs:label "Acreedor Privilegiado"@es ;
    rdfs:comment "Acreedor con prelacion legal en el pago de sus creditos (ej. entidades financieras, trabajadores)."@es .

ins:AcreedorOrdinario    a owl:Class ;
    rdfs:subClassOf ins:Acreedor ;
    rdfs:label "Acreedor Ordinario"@es ;
    rdfs:comment "Acreedor sin privilegio especial en el orden de pago."@es .

ins:Liquidador        a owl:Class ;
    rdfs:subClassOf ins:EntidadJuridica ;
    rdfs:label "Liquidador"@es ;
    rdfs:comment "Persona designada para administrar y liquidar los bienes del deudor."@es .

ins:ProcedimientoInsolvencia a owl:Class ;
    rdfs:label "Procedimiento de Insolvencia"@es ;
    rdfs:comment "Proceso legal mediante el cual se tramita la insolvencia de un deudor."@es .

ins:Reorganizacion    a owl:Class ;
    rdfs:subClassOf ins:ProcedimientoInsolvencia ;
    rdfs:label "Reorganizacion"@es ;
    rdfs:comment "Proceso de reorganizacion empresarial regulado por el Titulo II de la Ley 1116 de 2006."@es .

ins:Liquidacion       a owl:Class ;
    rdfs:subClassOf ins:ProcedimientoInsolvencia ;
    rdfs:label "Liquidacion Judicial"@es ;
    rdfs:comment "Proceso de liquidacion judicial regulado por el Titulo III de la Ley 1116 de 2006."@es .

ins:ActoJuridico      a owl:Class ;
    rdfs:label "Acto Juridico"@es ;
    rdfs:comment "Acto procesal emitido en el marco de un procedimiento de insolvencia."@es .

ins:AutoAdmision      a owl:Class ;
    rdfs:subClassOf ins:ActoJuridico ;
    rdfs:label "Auto de Admision"@es ;
    rdfs:comment "Resolucion judicial que admite al deudor al proceso de insolvencia."@es .

ins:AcuerdoReorganizacion a owl:Class ;
    rdfs:subClassOf ins:ActoJuridico ;
    rdfs:label "Acuerdo de Reorganizacion"@es ;
    rdfs:comment "Acuerdo celebrado entre el deudor y sus acreedores para reestructurar las obligaciones."@es .

ins:Obligacion        a owl:Class ;
    rdfs:label "Obligacion"@es ;
    rdfs:comment "Deuda u obligacion financiera del deudor frente a un acreedor."@es .

ins:Garantia          a owl:Class ;
    rdfs:label "Garantia"@es ;
    rdfs:comment "Bien o derecho que respalda el cumplimiento de una obligacion."@es .

ins:OrganoDecisorio   a owl:Class ;
    rdfs:label "Organo Decisorio"@es ;
    rdfs:comment "Entidad con facultad para tomar decisiones en el proceso de insolvencia."@es .

ins:JuntaAcreedores   a owl:Class ;
    rdfs:subClassOf ins:OrganoDecisorio ;
    rdfs:label "Junta de Acreedores"@es ;
    rdfs:comment "Organo colegiado conformado por los acreedores reconocidos en el proceso."@es .

ins:Superintendencia  a owl:Class ;
    rdfs:subClassOf ins:OrganoDecisorio ;
    rdfs:label "Superintendencia"@es ;
    rdfs:comment "Entidad estatal que ejerce funciones jurisdiccionales en procesos de insolvencia."@es .

ins:NormaLegal        a owl:Class ;
    rdfs:label "Norma Legal"@es ;
    rdfs:comment "Disposicion normativa aplicable al regimen de insolvencia."@es .

ins:Ley               a owl:Class ;
    rdfs:subClassOf ins:NormaLegal ;
    rdfs:label "Ley"@es .

ins:Decreto           a owl:Class ;
    rdfs:subClassOf ins:NormaLegal ;
    rdfs:label "Decreto"@es .

###############################################################################
# DisjointClasses (>= 2 pares)
###############################################################################
# Disjoint 1: Un procedimiento es Reorganizacion O Liquidacion, nunca ambos
[ a owl:AllDisjointClasses ;
  owl:members ( ins:Reorganizacion ins:Liquidacion ) ] .

# Disjoint 2: Un acreedor es Privilegiado O Ordinario, nunca ambos
[ a owl:AllDisjointClasses ;
  owl:members ( ins:AcreedorPrivilegiado ins:AcreedorOrdinario ) ] .

###############################################################################
# Constructor logico: owl:unionOf
# Un Deudor es equivalente a PersonaJuridica O PersonaNatural
###############################################################################
ins:Deudor owl:equivalentClass [
    a owl:Class ;
    owl:unionOf ( ins:PersonaJuridica ins:PersonaNatural )
] .

###############################################################################
# Object Properties (12 propiedades objeto)
###############################################################################

# --- Relacion Deudor-Acreedor ---
ins:tieneAcreedor a owl:ObjectProperty ;
    rdfs:domain ins:Deudor ;
    rdfs:range  ins:Acreedor ;
    rdfs:label  "tiene acreedor"@es ;
    rdfs:comment "Relaciona un deudor con sus acreedores."@es .

ins:esAcreedorDe a owl:ObjectProperty ;
    owl:inverseOf ins:tieneAcreedor ;          # inverseOf (1)
    rdfs:domain ins:Acreedor ;
    rdfs:range  ins:Deudor ;
    rdfs:label  "es acreedor de"@es .

# --- Relacion Deudor-Procedimiento ---
ins:iniciaEn a owl:ObjectProperty ;
    rdfs:domain ins:Deudor ;
    rdfs:range  ins:ProcedimientoInsolvencia ;
    rdfs:label  "inicia en"@es ;
    rdfs:comment "Indica que un deudor inicia un procedimiento de insolvencia."@es .

ins:esIniciadoPor a owl:ObjectProperty ;
    owl:inverseOf ins:iniciaEn ;               # inverseOf (2)
    rdfs:domain ins:ProcedimientoInsolvencia ;
    rdfs:range  ins:Deudor ;
    rdfs:label  "es iniciado por"@es .

# --- Relacion Procedimiento-Regulacion ---
ins:estaReguladoPor a owl:ObjectProperty ;
    rdfs:domain ins:ProcedimientoInsolvencia ;
    rdfs:range  ins:NormaLegal ;
    rdfs:label  "esta regulado por"@es ;
    rdfs:comment "Indica la norma legal que regula un procedimiento."@es .

# --- Relacion Procedimiento-Supervision ---
ins:esSupervisadoPor a owl:ObjectProperty ;
    rdfs:subPropertyOf ins:estaReguladoPor ;   # subPropertyOf (2): supervision es una forma de regulacion
    rdfs:domain ins:ProcedimientoInsolvencia ;
    rdfs:range  ins:OrganoDecisorio ;
    rdfs:label  "es supervisado por"@es ;
    rdfs:comment "Indica el organo que supervisa un procedimiento de insolvencia."@es .

# --- Relacion OrganoDecisorio-ActoJuridico ---
ins:emite a owl:ObjectProperty ;
    rdfs:domain ins:OrganoDecisorio ;
    rdfs:range  ins:ActoJuridico ;
    rdfs:label  "emite"@es ;
    rdfs:comment "Indica que un organo decisorio emite un acto juridico."@es .

# --- Relacion Obligacion-Garantia ---
ins:tieneGarantia a owl:ObjectProperty ;
    rdfs:domain ins:Obligacion ;
    rdfs:range  ins:Garantia ;
    rdfs:label  "tiene garantia"@es ;
    rdfs:comment "Indica que una obligacion esta respaldada por una garantia."@es .

# --- Relacion Acreedor-Junta ---
ins:participaEn a owl:ObjectProperty ;
    rdfs:domain ins:Acreedor ;
    rdfs:range  ins:JuntaAcreedores ;
    rdfs:label  "participa en"@es ;
    rdfs:comment "Indica que un acreedor participa en una junta de acreedores."@es .

# --- Relacion Deudor-Obligacion ---
ins:tieneObligacion a owl:ObjectProperty ;
    rdfs:domain ins:Deudor ;
    rdfs:range  ins:Obligacion ;
    rdfs:label  "tiene obligacion"@es ;
    rdfs:comment "Relaciona un deudor con sus obligaciones financieras."@es .

# --- Relacion OrganoDecisorio-Liquidador ---
ins:designaLiquidador a owl:ObjectProperty ;
    rdfs:domain ins:OrganoDecisorio ;
    rdfs:range  ins:Liquidador ;
    rdfs:label  "designa liquidador"@es ;
    rdfs:comment "Indica que un organo decisorio designa a un liquidador."@es .

# --- subPropertyOf (1): acreedor privilegiado es un tipo de acreedor ---
ins:tieneAcreedorPrivilegiado a owl:ObjectProperty ;
    rdfs:subPropertyOf ins:tieneAcreedor ;     # subPropertyOf (1)
    rdfs:domain ins:Deudor ;
    rdfs:range  ins:AcreedorPrivilegiado ;
    rdfs:label  "tiene acreedor privilegiado"@es .

###############################################################################
# Datatype Properties (6 propiedades de datos)
###############################################################################
ins:nombreRazonSocial a owl:DatatypeProperty ;
    rdfs:domain ins:EntidadJuridica ;
    rdfs:range  xsd:string ;
    rdfs:label  "nombre o razon social"@es .

ins:nit a owl:DatatypeProperty ;
    rdfs:domain ins:PersonaJuridica ;
    rdfs:range  xsd:string ;
    rdfs:label  "NIT"@es ;
    rdfs:comment "Numero de Identificacion Tributaria."@es .

ins:fechaAdmision a owl:DatatypeProperty ;
    rdfs:domain ins:ProcedimientoInsolvencia ;
    rdfs:range  xsd:date ;
    rdfs:label  "fecha de admision"@es .

ins:montoObligacion a owl:DatatypeProperty ;
    rdfs:domain ins:Obligacion ;
    rdfs:range  xsd:decimal ;
    rdfs:label  "monto de la obligacion"@es .

ins:numeroNorma a owl:DatatypeProperty ;
    rdfs:domain ins:NormaLegal ;
    rdfs:range  xsd:string ;
    rdfs:label  "numero de la norma"@es .

ins:anoExpedicion a owl:DatatypeProperty ;
    rdfs:domain ins:NormaLegal ;
    rdfs:range  xsd:gYear ;
    rdfs:label  "ano de expedicion"@es .

###############################################################################
# Property Restrictions
###############################################################################

# allValuesFrom: todos los acreedores de un Deudor deben ser instancias de Acreedor
ins:Deudor rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ins:tieneAcreedor ;
    owl:allValuesFrom ins:Acreedor
] .

# someValuesFrom: todo Procedimiento de Insolvencia tiene al menos un organo que lo supervisa
ins:ProcedimientoInsolvencia rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ins:esSupervisadoPor ;
    owl:someValuesFrom ins:OrganoDecisorio
] .

# Cardinality: un Acuerdo de Reorganizacion tiene exactamente 1 Deudor que lo inicia
ins:AcuerdoReorganizacion rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ins:esIniciadoPor ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

###############################################################################
# Named Individuals
###############################################################################

# ============================================================================
# NormaLegal (5 individuos)
# ============================================================================
ins:Ley1116_2006 a ins:Ley ;
    ins:numeroNorma "1116" ;
    ins:anoExpedicion "2006"^^xsd:gYear ;
    rdfs:label "Ley 1116 de 2006"@es ;
    rdfs:comment "Regimen de Insolvencia Empresarial de Colombia."@es .

ins:Decreto806_2020 a ins:Decreto ;
    ins:numeroNorma "806" ;
    ins:anoExpedicion "2020"^^xsd:gYear ;
    rdfs:label "Decreto 806 de 2020"@es ;
    rdfs:comment "Medidas para implementar las TIC en las actuaciones judiciales."@es .

ins:Decreto772_2020 a ins:Decreto ;
    ins:numeroNorma "772" ;
    ins:anoExpedicion "2020"^^xsd:gYear ;
    rdfs:label "Decreto 772 de 2020"@es ;
    rdfs:comment "Medidas transitorias en materia de insolvencia."@es .

ins:Ley2445_2025 a ins:Ley ;
    ins:numeroNorma "2445" ;
    ins:anoExpedicion "2025"^^xsd:gYear ;
    rdfs:label "Ley 2445 de 2025"@es .

ins:Ley1564_2012 a ins:Ley ;
    ins:numeroNorma "1564" ;
    ins:anoExpedicion "2012"^^xsd:gYear ;
    rdfs:label "Codigo General del Proceso"@es .

# ============================================================================
# OrganoDecisorio (4 individuos)
# ============================================================================
ins:SuperintendenciaSociedades a ins:Superintendencia ;
    ins:nombreRazonSocial "Superintendencia de Sociedades"^^xsd:string ;
    rdfs:label "Superintendencia de Sociedades"@es .

ins:SuperintendenciaFinanciera a ins:Superintendencia ;
    ins:nombreRazonSocial "Superintendencia Financiera de Colombia"^^xsd:string ;
    rdfs:label "Superintendencia Financiera"@es .

ins:JuntaAcreedores_ReorgEjemplo1 a ins:JuntaAcreedores ;
    rdfs:label "Junta de Acreedores - Reorganizacion Ejemplo 1"@es .

ins:JuntaAcreedores_LiquidEjemplo1 a ins:JuntaAcreedores ;
    rdfs:label "Junta de Acreedores - Liquidacion Ejemplo 1"@es .

# ============================================================================
# ProcedimientoInsolvencia (4 individuos)
# ============================================================================
ins:ReorgEjemplo1 a ins:Reorganizacion ;
